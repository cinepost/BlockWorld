 vec3 origin=p.cascade_center.xyz+p.light_right.xyz*xy.x+p.light_up.xyz*xy.y+p.sun.xyz*p.shadow_controls.z;
 MeshHit hit=query_mesh(origin,-p.sun.xyz,p.shadow_controls.w);
 far_depth[id.x+p.sky_state.w*id.y+(p.sky_state.w*p.sky_state.w)*(id.z+4)]=hit.flags==0?0:ordered_depth(p.shadow_controls.z-hit.normal_depth.w);
