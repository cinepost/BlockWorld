float far_sunlight(vec3 point,vec3 normal,bool polygon) {
 if(p.soft.y<0.5 && polygon && cascade_clear(point))return 1;
 vec3 v=point-p.cascade_center.xyz;vec2 xy=vec2(dot(v,p.light_right.xyz),dot(v,p.light_up.xyz));
 for(uint c=0;c<4;c++) {
  vec2 d=abs(xy-cascade_offset(c));float guard=p.soft.y>0.5?shadow_search_world(point,polygon):0;float extent=(max(d.x,d.y)+guard)/radius(c);
