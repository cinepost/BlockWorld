  uint oi=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true);
  uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(query,true);
  Object object=objects[oi];Triangle tri=triangles[object.info.x+primitive];
  vec2 bary=rayQueryGetIntersectionBarycentricsEXT(query,true);
  vec2 uv=tri.uv01.xy*(1.0-bary.x-bary.y)+tri.uv01.zw*bary.x+tri.uv2*bary.y;
  vec3 a=(object.world*vec4(tri.a.xyz,1)).xyz,b=(object.world*vec4(tri.b.xyz,1)).xyz,c=(object.world*vec4(tri.c.xyz,1)).xyz;
  vec3 normal=normalize(cross(b-a,c-a));if(dot(normal,direction)>0)normal=-normal;
  uint flags=1u|4u|((materials[tri.material-1].flags&1u)<<1u)|((oi+1u)<<8u);
  result=MeshHit(vec4(normal,rayQueryGetIntersectionTEXT(query,true)),fract(uv),tri.material,flags,uvec4(oi,primitive,0,p.screen.w>>1));
 }
 return result;
}
layout(set=0,binding=19,std430) readonly buffer Cascades {uint shadow_cascades[];};
uint ordered_depth(float v) {uint bits=floatBitsToUint(v);return (bits&0x80000000u)!=0u?~bits:bits^0x80000000u;}
bool cascade_clear(vec3 point) {
 if(p.acceleration.y==0u)return false;
 vec3 v=point-p.cascade_center.xyz;vec2 xy=vec2(dot(v,p.light_right.xyz),dot(v,p.light_up.xyz));
 for(uint c=0;c<4;c++) {
  float r=c==3?max(432.0,p.cascade_center.w):16.0*pow(3.0,float(c));vec2 uv=xy/(2*r)+0.5;
  if(any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(1))))continue;
  uvec2 q=min(uvec2(uv*128),uvec2(127));
  return shadow_cascades[q.x+128*q.y+16384*(c+4)]<ordered_depth(dot(v,p.sun.xyz)-0.002);
 }
 return false;
}

