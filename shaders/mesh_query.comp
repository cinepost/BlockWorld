float radius(uint c){return c==3?max(432.0,p.cascade_center.w):16.0*pow(3.0,float(c));}
vec2 cascade_offset(uint c) {
 float texel=2*radius(c)/float(p.sky_state.w);
 vec2 center=vec2(dot(p.cascade_center.xyz,p.light_right.xyz),dot(p.cascade_center.xyz,p.light_up.xyz));
 return floor(center/texel+0.5)*texel-center;
}
#ifndef SHADOW_CSM
float decode_depth(uint key) {return uintBitsToFloat((key&0x80000000u)!=0u?key^0x80000000u:~key);}
float shadow_blend(vec3 point) {
 if(p.shadow_controls.y<0.5)return 0;
 if(p.shadow_controls.y>1.5)return 1;
 float end=max(0.001,p.shadow_controls.x);
 return smoothstep(max(0,end-8),end,distance(point,p.eye.xyz));
}
uint shadow_hash(uint h) {h=(h^(h>>16))*0x7feb352du;h=(h^(h>>15))*0x846ca68bu;return h^(h>>16);}
uint shadow_key(ivec2 pixel,uint c,bool polygon) {
 if(any(lessThan(pixel,ivec2(0)))||any(greaterThanEqual(pixel,ivec2(int(p.sky_state.w)))))return 0;
 return far_depth[uint(pixel.x+pixel.y*int(p.sky_state.w))+(p.sky_state.w*p.sky_state.w)*(c+(polygon?4u:0u))];
}
float shadow_compare(ivec2 pixel,vec2 xy,vec2 plane,float z,float r,uint c,bool polygon) {
 vec2 sample_xy=((vec2(pixel)+0.5)/float(p.sky_state.w)*2-1)*r;
 float receiver=z-dot(plane,sample_xy-xy)+0.02;uint key=shadow_key(pixel,c,polygon);
 return key==0||decode_depth(key)<=receiver?1:0;
}
float shadow_bilinear(vec2 at,vec2 xy,vec2 plane,float z,float r,uint c,bool polygon) {
 ivec2 base=ivec2(floor(at));vec2 f=fract(at);
 float a=shadow_compare(base,xy,plane,z,r,c,polygon),b=shadow_compare(base+ivec2(1,0),xy,plane,z,r,c,polygon);
 float d=shadow_compare(base+ivec2(0,1),xy,plane,z,r,c,polygon),e=shadow_compare(base+ivec2(1,1),xy,plane,z,r,c,polygon);
 return mix(mix(a,b,f.x),mix(d,e,f.x),f.y);
