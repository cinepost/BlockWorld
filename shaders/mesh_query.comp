vec3 disk_direction(vec3 point,uint sample_id) {
 vec3 to_eye=point-p.eye.xyz;float depth=max(0.001,dot(to_eye,p.forward.xyz));
 vec2 uv=vec2(dot(to_eye,p.right.xyz)/(depth*p.eye.w*p.forward.w),-dot(to_eye,p.up.xyz)/(depth*p.forward.w))*0.5+0.5;
 ivec2 pixel=ivec2(floor(uv*vec2(p.screen.xy)));uint seed=shadow_hash(uint(pixel.x)^shadow_hash(uint(pixel.y))^p.history.z*0x9e3779b9u);
 float u=(float(shadow_hash(seed+sample_id*2)&0xffffffu)+0.5)/16777216.0;
 float v=(float(shadow_hash(seed+sample_id*2+1)&0xffffffu)+0.5)/16777216.0;
 float radius=sqrt(u)*tan(p.soft.x),angle=6.283185307*v;
