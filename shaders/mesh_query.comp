layout(set=0,binding=25) uniform sampler pack_sampler;
vec4 pack_texel(uint page,uvec2 origin,vec2 uv,bool linear_filter) {
#ifdef SINGLE_ATLAS
 #define PACK_IMAGE pack_images
#else
 #define PACK_IMAGE pack_images[nonuniformEXT(page)]
#endif
 vec2 local=fract(uv)*16;
 if(linear_filter)return textureLod(sampler2D(PACK_IMAGE,pack_sampler),(vec2(origin)+local)/vec2(textureSize(sampler2D(PACK_IMAGE,pack_sampler),0)),0);
