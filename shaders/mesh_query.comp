 vec2 uv=vec2(dot(delta,p.right.xyz)/(depth*p.eye.w*p.forward.w),-dot(delta,p.up.xyz)/(depth*p.forward.w))*0.5+0.5;
 ivec2 pixel=ivec2(floor(uv*vec2(p.screen.xy)));
