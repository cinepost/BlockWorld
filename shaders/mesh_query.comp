#ifdef SHADOW
layout(set=0,binding=23,std430) buffer ShadowRaw {vec4 shadow_raw[];};
float shadow(vec3 point,vec3 normal,out uint mask) {
 mask=15;
 if(p.effects.w<0.5 || dot(normal,p.sun.xyz)<=0) return 1;
 float blend=shadow_blend(point);
 if(blend>=1)return far_sunlight(point,normal);
 float estimate=p.soft.y>0.5?far_sunlight(point,normal):0;
 float voxel_estimate=p.soft.y>0.5?far_sunlight(point,normal,false):0;
 bool edge=p.soft.y>0.5 && ((estimate>0.001 && estimate<0.999)||(voxel_estimate>0.001 && voxel_estimate<0.999));
 float exact=0;
 if(edge) {
  uint count=uint(clamp(p.soft.z,2,4));mask=0;
  for(uint sample_id=0;sample_id<count;sample_id++) {bool lit=query_mesh(point+normal*0.003,disk_direction(point,sample_id),p.up.w).flags==0;exact+=lit?1:0;if(lit)mask|=1u<<sample_id;}
  exact/=float(count);mask|=16u;
 } else {
  if(p.soft.y<0.5 && cascade_clear(point+normal*0.003)) return 1;
  vec3 direction=p.soft.y>0.5?disk_direction(point,0u):p.sun.xyz;
  exact=query_mesh(point+normal*0.003,direction,p.up.w).flags==0?1:0;mask=exact>0?15u:0u;
