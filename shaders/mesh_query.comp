vec3 ray_at(uvec2 pixel) {
 vec2 xy=(vec2(pixel)+0.5)/vec2(p.screen.xy)*2.0-1.0;
 return normalize(p.forward.xyz+p.right.xyz*xy.x*p.eye.w*p.forward.w-p.up.xyz*xy.y*p.forward.w);
}
