}
layout(set=0,binding=27,std430) readonly buffer EntityPlayers {vec4 entity_players[];};
bool entity_in_range(vec3 point) {
 if(entity_players[0].y<0.5)return true;
 for(uint i=0;i<floatBitsToUint(entity_players[0].x);i++)if(all(lessThanEqual(abs(point-entity_players[i+1].xyz),vec3(32))))return true;
 return false;
}
MeshHit query_mesh(vec3 origin,vec3 direction,float limit) {
 MeshHit result=MeshHit(vec4(0,0,0,limit),vec2(0),0,0,uvec4(0));
 if(p.meshes.x==0 || limit<=0.001 || !scene_box(origin,direction,limit)) return result;
