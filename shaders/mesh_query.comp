}

bool scene_box(vec3 origin,vec3 ray,float limit) {
 float near=0,far=limit;
 for(uint a=0;a<3;a++) {
  if(abs(ray[a])<0.000001) {if(origin[a]<p.scene_min[a] || origin[a]>p.scene_max[a])return false;}
  else {float t1=(p.scene_min[a]-origin[a])/ray[a],t2=(p.scene_max[a]-origin[a])/ray[a];near=max(near,min(t1,t2));far=min(far,max(t1,t2));}
 }
