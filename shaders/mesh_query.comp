 rayQueryInitializeEXT(query,scene,entity_players[0].y>0.5?gl_RayFlagsNoOpaqueEXT:0,mask,origin,0.001,direction,limit);
 while(rayQueryProceedEXT(query)) {
  if(rayQueryGetIntersectionTypeEXT(query,false)!=gl_RayQueryCandidateIntersectionTriangleEXT) continue;
  uint oi=rayQueryGetIntersectionInstanceCustomIndexEXT(query,false);
  if(objects[oi].info.z==0u && !entity_in_range(objects[oi].world[3].xyz))continue;
  uint primitive=rayQueryGetIntersectionPrimitiveIndexEXT(query,false);
  Triangle tri=triangles[objects[oi].info.x+primitive];
  vec2 bary=rayQueryGetIntersectionBarycentricsEXT(query,false);
  vec2 uv=tri.uv01.xy*(1.0-bary.x-bary.y)+tri.uv01.zw*bary.x+tri.uv2*bary.y;
  if(covered(tri.material,uv)) rayQueryConfirmIntersectionEXT(query);
 }
